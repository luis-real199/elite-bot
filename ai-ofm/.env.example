# Κοινά κλειδιά για ΟΛΕΣ τις περσόνες. Αντέγραψέ το σε .env και συμπλήρωσε.
# Τα κλειδιά κάθε περσόνας (Telegram bot, κανάλια Buffer) είναι στο personas/<όνομα>/.env.
# Ποτέ μην ανεβάσεις .env στο GitHub.

# Το μοντέλο που γράφει πλάνα, captions, chat και ελέγχει εικόνες. Βάλε ΕΝΑ από τα τρία,
# ανάλογα με το models.llm.provider στο persona.yaml:
# Groq (δωρεάν, προεπιλογή): https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (δωρεάν): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude (πληρωμένο, καλύτερο): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# fal.ai (εικόνες, βίντεο, LoRA): https://fal.ai/dashboard/keys
FAL_KEY=

# Το δικό σου Telegram ID (ίδιο για όλα τα bots). Το βρίσκεις με:
# docker compose run --rm sienna python -m ofm telegram-id
TELEGRAM_OWNER_ID=

# Buffer (αυτόματο ανέβασμα): publish.buffer.com → Settings → API
BUFFER_API_KEY=

# Supabase Storage (δημόσια links για το Buffer). Project Settings → API Keys → secret key
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=ofm-media

# Fanvue API (αυτόματο ανέβασμα και chat): fanvue.com/developers → Create app (θέλει ολοκληρωμένο KYC)
# Ένα app για όλες τις περσόνες: κάθε περσόνα κάνει δικό της /fanvue_login από το δικό της bot.
# Redirect URI: το ίδιο με εδώ (οποιοδήποτε https, δεν χρειάζεται να ανοίγει).
# Scopes: read:self read:chat write:chat read:post write:post read:media write:media
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_REDIRECT_URI=https://ofm-bot.example/callback
