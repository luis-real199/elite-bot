# Αντέγραψέ το σε .env και συμπλήρωσε. Ποτέ μην ανεβάσεις το .env στο GitHub.

# Claude (πλάνο και captions): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# fal.ai (εικόνες, βίντεο, LoRA): https://fal.ai/dashboard/keys
FAL_KEY=

# Telegram: @BotFather → /newbot. Το ID σου το βρίσκεις με: python -m ofm telegram-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Buffer (αυτόματο ανέβασμα): publish.buffer.com → Settings → API
# Τα IDs των καναλιών τα βρίσκεις με: python -m ofm buffer-channels
BUFFER_API_KEY=
BUFFER_CHANNEL_INSTAGRAM=
BUFFER_CHANNEL_TIKTOK=
BUFFER_CHANNEL_YOUTUBE=
BUFFER_CHANNEL_X=

# Supabase Storage (δημόσια links για το Buffer). Project Settings → API Keys → secret key
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=ofm-media

# Fanvue API (αυτόματο ανέβασμα και chat): fanvue.com/developers → Create app (θέλει ολοκληρωμένο KYC)
# Στο app βάλε Redirect URI το ίδιο που γράφεις εδώ (οποιοδήποτε https, δεν χρειάζεται να ανοίγει)
# και scopes: read:self read:chat write:chat read:post write:post read:media write:media
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_REDIRECT_URI=https://ofm-bot.example/callback

# Προαιρετικό: αν έχεις ήδη LoRA, βάλε το URL εδώ και προσπέρνα τα /faces, /dataset, /train
LORA_URL=
